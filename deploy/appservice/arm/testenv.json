{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "4536655207730501692"
    }
  },
  "parameters": {
    "prefix": {
      "type": "string",
      "defaultValue": "orchextest",
      "metadata": {
        "description": "Prefix for resource names."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region."
      }
    },
    "operatorObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object id of whoever runs the setup wizard, granted secret access on the vault."
      }
    }
  },
  "variables": {
    "storageName": "[toLower(take(replace(format('{0}stor', parameters('prefix')), '-', ''), 24))]",
    "vaultName": "[take(format('{0}-kv', parameters('prefix')), 24)]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('vaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": false,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "accessPolicies": "[if(empty(parameters('operatorObjectId')), createArray(), createArray(createObject('tenantId', subscription().tenantId, 'objectId', parameters('operatorObjectId'), 'permissions', createObject('secrets', createArray('get', 'list', 'set', 'delete')))))]"
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('vaultName')]"
    },
    "connectionStringHint": {
      "type": "string",
      "value": "[format('az storage account show-connection-string -n {0} -g {1} --query connectionString -o tsv', variables('storageName'), resourceGroup().name)]"
    }
  }
}